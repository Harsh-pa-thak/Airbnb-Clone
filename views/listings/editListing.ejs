<% layout('layouts/boilerplate') %>

<div class="row justify-content-center">

<div class="col-8">

<h1>Edit Listing: <%= listing.title %></h1>

<br>

<form action="/listings/<%= listing._id %>?_method=PUT"
method="POST"
novalidate
class="needs-validation">


<div class="mb-3">

<label class="form-label">Title</label>

<input class="form-control"
type="text"
name="title"
value="<%= listing.title %>"
required>

<div class="valid-feedback">Good title</div>

<div class="invalid-feedback">Enter valid title</div>

</div>


<div class="mb-3">

<label class="form-label">Description</label>

<textarea class="form-control"
name="description"
required>

<%= listing.description %>

</textarea>

<div class="invalid-feedback">
Enter valid description
</div>

</div>


<div class="row">

<div class="mb-3 col-md-4">

<label class="form-label">Price</label>

<input class="form-control"
type="number"
name="price"
value="<%= listing.price %>"
required>

<div class="invalid-feedback">
Enter valid price
</div>

</div>


<div class="mb-3 col-md-8">

<label class="form-label">Country</label>

<input class="form-control"
type="text"
name="country"
value="<%= listing.country %>"
required>

<div class="invalid-feedback">
Enter valid country
</div>

</div>

</div>


<div class="mb-3">

<label class="form-label">Location</label>

<input class="form-control"
type="text"
name="location"
value="<%= listing.location %>"
required>

<div class="invalid-feedback">
Enter valid location
</div>

</div>


<div class="mb-3">

<label class="form-label">Image URL</label>

<input class="form-control"
type="text"
name="image"
value="<%= listing.image %>"
required>

<div class="invalid-feedback">
Enter valid image
</div>

</div>


<button class="btn edit-btn">
Update Listing
</button>

</form>

</div>

</div>
<% layout('layouts/boilerplate') %>
<script>
  let maptoken = "<%= process.env.MAPBOX_TOKEN %>";
</script>
<div class="container mt-5">
  <div class="row">
    <div class="col-md-8 offset-md-2">

      <h2 class="mb-4"><%= listing.title %></h2>
      <% 
        const ownerName = (listing.owner && listing.owner.username) ? listing.owner.username : "Unknown";
        const canManageListing = !!(
          currentUser &&
          listing.owner &&
          currentUser._id &&
          listing.owner._id &&
          String(currentUser._id) === String(listing.owner._id)
        );
      %>

      <div class="card border-0 shadow-sm rounded-4">

        <img 
          src="<%= listing.image.url %>" 
          alt="<%= listing.title %>" 
          class="img-fluid rounded-top-4"
          style="height: 350px; width: 100%; object-fit: cover;"
        >

        <div class="card-body">
           <p class="text-muted mb-3">
            Post Listed by : <i><%= ownerName %></i>
          </p>
          <p class="text-muted mb-3">
            <%= listing.description %>
          </p>

          <p class="fw-semibold fs-5">
            ₹ <%= listing.price %>
          </p>

          <p class="text-muted">
            <%= listing.location %>, <%= listing.country %>
          </p>
        <% if (canManageListing) { %>
          <div class="d-flex gap-3 mt-4">
            <form action="/listings/<%= listing._id %>/edit" method="GET">
              <button type="submit" class="btn btn-danger px-4">
                Edit
              </button>
            </form>
            <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
              <button type="submit" class="btn btn-dark px-4">
                Delete
              </button>
            </form>
          </div>
          <% } %>

        </div>
      </div>
      <%if (currentUser) { %>
      <div class="card mt-5 shadow-sm rounded-4">
        <div class="card-body">

          <h4 class="mb-4">Leave a Review</h4>

          <form action="/listings/<%= listing._id %>/reviews" novalidate class="needs-validation" method="POST">

            <div class="mb-4">
              <span class="form-label d-block">Rating</span>

              <fieldset class="starability-slot" aria-label="Choose a rating">
                <input type="radio" id="rating-0" class="input-no-rate" name="review[rating]" value="" aria-label="No rating." checked>
                <input type="radio" id="rating-5" name="review[rating]" value="5">
                <label for="rating-5" title="Amazing">5 stars</label>
                <input type="radio" id="rating-4" name="review[rating]" value="4">
                <label for="rating-4" title="Very good">4 stars</label>
                <input type="radio" id="rating-3" name="review[rating]" value="3">
                <label for="rating-3" title="Average">3 stars</label>
                <input type="radio" id="rating-2" name="review[rating]" value="2">
                <label for="rating-2" title="Not good">2 stars</label>
                <input type="radio" id="rating-1" name="review[rating]" value="1" required>
                <label for="rating-1" title="Terrible">1 star</label>
              </fieldset>
            </div>

 
            <div class="mb-4">
              <label for="comment" class="form-label">Comments</label>
              <textarea 
                name="review[comment]" 
                id="comment" 
                rows="5" 
                class="form-control"
                required
              ></textarea>
              <div class="invalid-feedback">Enter a valid Comment</div>
            </div>

            <button 
              type="submit" 
              class="btn text-white px-4"
              style="background-color: #fe424d; border: none;">
              Submit
            </button>

          </form>

        </div>
      </div>
      <% } %>
      <hr>
      
      <% if(listing.reviews.length > 0) { %>
        <h4 class="mb-4 fw-semibold">All Reviews</h4>
      <div class="mt-5">
        <h4 class="mb-4 fw-semibold">All Reviews</h4>

        <div class="row g-4">
          <% for (let r of listing.reviews) { %>

            <div class="col-md-6">
              <div class="card border-0 shadow-sm rounded-4 p-3 h-100 d-flex flex-column justify-content-between">
                
                <div>
                  <div>
                    <p class="fw-semibold">@ <%= (r.author && r.author.username) ? r.author.username : "Anonymous" %></p>
                  </div>
                  <div class="mb-2">
                    <% for(let i = 1; i <= 5; i++) { %>
                      <% if(i <= r.rating) { %>
                        <span class="text-danger fs-5">&#9733;</span>
                      <% } else { %>
                        <span class="text-muted fs-5">&#9734;</span>
                      <% } %>
                    <% } %>
                  </div>

                  <p class="mb-3 text-dark">
                    <%= r.comment %>
                  </p>
                </div>

                <form method="POST" action="/listings/<%=listing._id%>/reviews/<%=r._id%>?_method=DELETE">
                  <button class="btn btn-sm btn-outline-danger">
                    Delete
                  </button>
                </form>

              </div>
            </div>

          <% } %>
        </div>
      </div>
      <% } %>
      <div class="col-md-8">
        <h3> Where you can find us !!</h3>
        <div id="map"></div>
      </div>  
    </div>
  </div>
</div>
<br>

<script src="/js/mapbox.js"></script>

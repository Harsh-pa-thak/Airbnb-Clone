<% layout('layouts/boilerplate') %>

<div class="container mt-5">
  <div class="row">
    <div class="col-md-8 offset-md-2">

      <!-- Listing Title -->
      <h2 class="mb-4"><%= listing.title %></h2>

      <!-- Card -->
      <div class="card border-0 shadow-sm rounded-4">

        <!-- Image -->
        <img 
          src="<%= listing.image %>" 
          alt="<%= listing.title %>" 
          class="img-fluid rounded-top-4"
          style="height: 350px; width: 100%; object-fit: cover;"
        >

        <!-- Card Body -->
        <div class="card-body">

          <p class="text-muted mb-3">
            <%= listing.description %>
          </p>

          <p class="fw-semibold fs-5">
            ₹ <%= listing.price %>
          </p>

          <p class="text-muted">
            <%= listing.location %>, <%= listing.country %>
          </p>

          <!-- Buttons -->
          <div class="d-flex gap-3 mt-4">
            <a href="/editListings/<%= listing._id %>" 
               class="btn btn-danger px-4">
              Edit
            </a>

            <form action="/listings/<%= listing._id %>?_method=DELETE" 
                  method="POST">
              <button type="submit" 
                      class="btn btn-dark px-4">
                Delete
              </button>
            </form>
          </div>

        </div>
      </div>

      
      <div class="card mt-5 shadow-sm rounded-4">
        <div class="card-body">

          <h4 class="mb-4">Leave a Review</h4>

          <form action="/listings/<%= listing._id %>/reviews" method="POST">

            
            <div class="mb-3">
              <label for="rating" class="form-label">Rating</label>
              <input 
                type="range" 
                min="1" 
                max="5" 
                id="rating" 
                name="review[rating]" 
              >
            </div>

            
            <div class="mb-3">
              <label for="comment" class="form-label">Comments</label>
              <textarea 
                name="review[comment]" 
                id="comment" 
                cols="30" 
                rows="5" 
                class="form-control"
                required
              ></textarea>
            </div>

            <button type="submit" class="btn btn-primary px-4" style="background-color: #fe424d !important; border: none;">
              Submit
            </button>

          </form>

        </div>
      </div>

    </div>
  </div>
</div>

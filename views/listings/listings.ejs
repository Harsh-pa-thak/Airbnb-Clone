<% layout('layouts/boilerplate') %>

<body>
    <h1>Available Listings</h1>
    <button><a href="/newListing">Create New Listing</a></button>
    <ul>
        <% for(let data of listings) { %>
        <li><h4><a href="/listing-detail/<%= data._id %>"><%= data.title %></a></h4></li>
        <% } %>
    </ul>
</body>


